Envs:
export PAYMENT_SERVICE_NAME=darkside
export PAYMENT_TOKEN=...
export PAYMENT_ACCOUNTS=acc-13
export PAYMENT_HOST=localhost
export PAYMENT_PORT=1234


curl http://localhost:1234/test/run \
  -X POST \
  -H "Content-Type: application/json" \
  -d '{
      "serviceName": "darkside",
      "token": "...",
      "ratePerSecond": 4000,
      "testCount": 1500000,
      "processingTimeMillis": 1000
  }'



### Stop running test to save time and resources
# @timeout 120
POST http://localhost:1234/test/stop/darkside
