### Run test locally
POST http://localhost:1234/test/run
Content-Type: application/json

{
  "serviceName": "darkside",
  "token": "secret",
  "ratePerSecond": 15,
  "testCount": 3000,
  "processingTimeMillis": 2500
}

mvn dependency:go-offline
mvn package && java -jar target/demo-0.0.1-SNAPSHOT.jar

